HKLM,%UninstallKey%,DisplayName,,"%PackageName%"
HKLM,%UninstallKey%,UninstallString,,"RunDll32.exe %11%\AdvPack.Dll,LaunchINFSection %17%\TWEAKS.INF,DefaultUninstall"

