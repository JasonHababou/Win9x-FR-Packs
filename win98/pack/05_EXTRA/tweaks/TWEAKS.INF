; ============================================================
; TWEAKS.INF - Reglages de performance du pack Win98FR
; Fusion de TWEAKS366.INF (U98SESP3.66) et tweaks.inf (SP3.0 B4 FR) :
;  - SP3.0 FR : cache d'icones 2048, ConservativeSwapfileUsage,
;    DMABufferSize=64, LocalLoadHigh=1, etiquette FR
;  - 3.66     : menus contextuels / glisser-deposer "Copier vers",
;    "Deplacer vers" et "Envoyer vers", msdos.sys SystemReg=0
; Remplace aussi %17%\TWEAKS.INF (copie SP3.0) pour que la
; desinstallation utilise ce fichier. La desinstallation ne retire
; pas "Envoyer vers" (present d'origine dans Windows 98).
; ============================================================
[Version]
Signature=$CHICAGO$
AdvancedINF=2.5

[DefaultInstall]
SmartReboot=N
CopyFiles=Tweaks.Inf
AddReg=AddReg.Tweaks
UpdateInis=UpdateInis.Tweaks

[DefaultUninstall]
SmartReboot=N
Cleanup=1
DelReg=DelReg.Uninst.Tweaks
UpdateInis=UpdateInis.Uninst.Tweaks

[DestinationDirs]
Tweaks.Inf=17

[Tweaks.Inf]
TWEAKS.INF

[AddReg.Tweaks]
HKLM,"Software\Microsoft\Windows\CurrentVersion\Explorer","Max Cached Icons",,"2048"
HKLM,"SOFTWARE\Classes\*\shellex\ContextMenuHandlers\Copy To",,,"{C2FBB630-2971-11D1-A18C-00C04FD75D13}"
