; ============================================================
; FINRUN.INF - Pack Win98FR : fin de l'installation, retire la reprise
; automatique (valeur Run\W98FR = command.com /c C:\W98FR\GO.BAT).
; L'ancien effacement par WSH (RegDelete) laissait la valeur en place :
; une fenetre MS-DOS "fichier introuvable" s'ouvrait a chaque demarrage
; (Sauvegardes 5, 6 et 7, GX240 2026-10-17). DelReg d'ADVPACK = fiable.
; ============================================================
[Version]
Signature=$CHICAGO$
AdvancedINF=2.5

[DefaultInstall]
SmartReboot=N
DelReg=FinReprise,FinComposants
DelFiles=FinComposants.Inf

[FinReprise]
HKLM,"Software\Microsoft\Windows\CurrentVersion\Run","W98FR"

; ISO Win98FR : groupe "Pack Windows 98 FR" de l'installation de Windows
; (W98FRPK.INF) retire d'Ajout/Suppression une fois le pack installe
[FinComposants]
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents","W98FRTop"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents\W98FRTop"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents","W98FR_366"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents\W98FR_366"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents","W98FR_PMEM"
