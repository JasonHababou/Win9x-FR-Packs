HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents","W98FR_CHIP"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents\W98FR_CHIP"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents","W98FR_DOSH"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents\W98FR_DOSH"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents","W98FR_LOGO"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents\W98FR_LOGO"
