HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents","W98FR_DMA"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents\W98FR_DMA"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OptionalComponents","W98FR_NVSURV"
